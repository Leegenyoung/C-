#define _CRT_SECURE_NO_WARNINGS
#pragma warning(disable:6031)
#include <stdio.h>

#define UP 10
#define DOWN 20
#define LEFT 30
#define RIGHT 40

int main() {
    int direction = UP;

    switch (direction) {
    case UP:
        printf("현재방향: 위");
        break;

    case DOWN:
        printf("현재방향: 아래");
        break;

    case LEFT:
        printf("현재방향: 왼쪽");
        break;

    case RIGHT:
        printf("현재방향: 오른쪽");
        break;
    }
    return 0;
}
